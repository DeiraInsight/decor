# 1. Pastikan folder dan file .gitkeep ada (untuk memancing Git)
mkdir -p storage/temp storage/upload
touch storage/temp/.gitkeep storage/upload/.gitkeep

# 2. Simpan perubahan ke Git
git add .
git commit -m "fix: penyempurnaan pembuatan folder storage otomatis dan sinkronisasi penamaan direktori upload"

# 3. Unggah ke GitHub
git push origin main