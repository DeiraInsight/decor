<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$decor_title ?? 'DECOR Framework'}</title>
    <style>
        :root {
            --bg-dark: #0f172a;
            --bg-card: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.2);
            --code-bg: #0b1120;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background-image: radial-gradient(circle at top right, var(--accent-glow), transparent 40%);
        }

        .container {
            max-width: 900px;
            width: 100%;
            text-align: center;
        }

        .logo-area { margin-bottom: 2rem; }
        
        h1 {
            font-size: 4rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 0.5rem;
            background: linear-gradient(to right, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .version {
            font-size: 1rem;
            background: var(--accent);
            color: #fff;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            vertical-align: middle;
            margin-left: 10px;
            -webkit-text-fill-color: #fff;
        }

        .tagline {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            font-weight: 300;
        }

        .welcome-box {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: var(--accent);
            padding: 1rem 1.5rem;
            border-radius: 8px;
            display: inline-block;
            margin-bottom: 2rem;
            font-size: 0.95rem;
            backdrop-filter: blur(5px);
        }

        .getting-started {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 1.5rem;
            margin: 0 auto 2rem auto;
            max-width: 600px;
            text-align: left;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .getting-started p {
            color: var(--text-main);
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .code-path {
            background: var(--code-bg);
            padding: 0.75rem 1rem;
            border-radius: 6px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.85rem;
            color: #e2e8f0;
            margin-bottom: 0.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .code-path:last-child {
            margin-bottom: 0;
        }

        .code-label {
            color: var(--text-muted);
            font-family: sans-serif;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .code-value {
            color: #38bdf8;
        }

        .render-badge {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.5rem 1.2rem;
            border-radius: 50px;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0 auto;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: monospace;
            transition: all 0.3s ease;
        }

        .render-badge:hover {
            border-color: rgba(16, 185, 129, 0.3);
            color: var(--text-main);
            background: rgba(16, 185, 129, 0.05);
        }

        .render-badge span {
            color: var(--accent);
            font-weight: 700;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Area ini yang akan diisi oleh file home.latte -->
        {block content}{/block}
    </div>

    <!-- Script Penghitung Kecepatan Render -->
    <script>
        window.addEventListener('load', () => {
            const time = performance.now().toFixed(2);
            const renderEl = document.getElementById('render-time');
            if(renderEl) renderEl.innerText = time;
        });
    </script>
</body>
</html>