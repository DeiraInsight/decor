{layout 'layouts/main.latte'}

{block content}
    <div class="logo-area">
        <h1>DECOR <span class="version">{$decor_version}</span></h1>
        <p class="tagline">
            Native PHP, elevated. Lightweight, secure, and enterprise-ready — truly open and free for all.
        </p>
        
        <!-- Kotak Sambutan & Terima Kasih -->
        <div class="welcome-box">
            🎉 <strong>Welcome Aboard!</strong> 
            You have successfully initialized the DECOR Starter Kit — 
            your ideal foundation to build faster, scale with confidence, 
            and code without compromise.
        </div>
    </div>

    <!-- Instruksi Langkah Selanjutnya -->
    <div class="getting-started">
        <p>🚀 Start Crafting Your Masterpiece:</p>
        <div class="code-path">
            <span class="code-label">VIEW PAGE</span>
            <span class="code-value">public/index.php</span>
        </div>
        <div class="code-path">
            <span class="code-label">EDIT TEMPLATE</span>
            <span class="code-value">views/home.latte</span>
        </div>
        <div class="code-path">
            <span class="code-label">CONTROLLER LOGIC</span>
            <span class="code-value">src/Actions/HomeAction.php</span>
        </div>
    </div>

    <!-- Lencana Kecepatan Render -->
    <div class="render-badge">
        ⚡ Page rendered in <span id="render-time">0.00</span> ms
    </div>
{/block}